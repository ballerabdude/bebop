[Unit]
Description=Bebop voice — on-device agent gateway (TensorRT Edge-LLM: ASR -> brain -> TTS cascade, or Qwen3-Omni) on :9093
Documentation=https://github.com/ballerabdude/bebop
# The voice service owns large GPU models and talks to the local TensorRT
# Edge-LLM servers it supervises (the cascade by default; omni is selectable
# from the app). It does not need the runtime to be up to start, but
# ordering keeps the two from racing at boot when the operator has enabled
# this unit.
After=network-online.target bebop-linux.service
Wants=network-online.target bebop-linux.service

[Service]
Type=simple
# Runs as root like bebop-vision: it reads the root-only HF token
# (/etc/bebop/hf_token) to fetch/refresh the checkpoint, the weights live
# under the repo checkout, and the TensorRT engine cache lives in
# /var/lib/bebop-voice. Root here is deliberate, not an oversight.
User=root
Group=root
WorkingDirectory=/home/bebop/bebop/bebop-vision
Environment=PYTHONUNBUFFERED=1
# Shares the project's single venv with the recorder/vision stack
# (bebop-vision/.venv, created with --system-site-packages so JetPack's
# TensorRT bindings are visible; see bebop-vision/requirements.txt).
# Bootstrap it with `install-jetson.sh --setup-voice` (see docs/voice.md).
ExecStart=/home/bebop/bebop/bebop-vision/.venv/bin/python -u -m bebop_vision.voice_server

# First start builds the checkpoint's TensorRT engines, which can take
# several minutes; give shutdown room to release the GPU and reap the
# child server before systemd escalates.
TimeoutStopSec=60
Restart=on-failure
RestartSec=5

[Install]
# Not enabled by install-jetson.sh by default: the operator starts and stops
# the voice service from the app (firmware drives systemd), because its first
# start builds TensorRT engines. `install-jetson.sh --enable-autostart` (or a
# bare `systemctl enable bebop-voice`) opts into auto-start at boot.
WantedBy=multi-user.target
