[Unit]
Description=Bebop Linux runtime (SocketCAN + WebSocket API)
Documentation=https://github.com/ballerabdude/bebop
# CAN interfaces are typically brought up via networkd / a shell script
# before this service starts. We don't `Requires=` any of them by name
# because the bus list is config-driven (see /etc/bebop/bebop_wheeled.yaml).
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Root, for parity with bebop-agent: the runtime opens raw SocketCAN
# sockets (CAP_NET_RAW), raises its control loop to SCHED_FIFO
# (CAP_SYS_NICE), writes the root-only Hugging Face token under /etc/bebop,
# and starts/stops the vision, voice and model-download units through
# systemctl.
User=root
Group=root

Environment=RUST_LOG=info,bebop_linux=info

# Persistent capture directory. `ProtectHome=read-only` (below) makes
# `/root` (and any `~`-style default) read-only for this service, which
# was producing a flood of "Read-only file system" errors from the
# always-on MCAP capture writer. `StateDirectory=bebop-captures` lets
# systemd create + own `/var/lib/bebop-captures` for us (mode 0750,
# owned by User=/Group= above), and we point the binary at that path
# explicitly via `--capture-dir` so it's used regardless of `$HOME`.
StateDirectory=bebop-captures
StateDirectoryMode=0750
ExecStart=/usr/local/bin/bebop-linux \
    --config /etc/bebop/bebop_wheeled.yaml \
    --capture-dir /var/lib/bebop-captures

# Restart after a crash or a config error. A CAN bus that isn't up yet is
# not fatal: the runtime starts anyway and picks the bus up once it appears.
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

# Hardening — relaxed for raw CAN + low-level access. `ProtectHome=read-only`
# means MCAP captures MUST land outside `/root`/`/home`; see
# `StateDirectory=bebop-captures` + the `--capture-dir` flag above. It is
# read-only (not `true`) because the firmware reads the shared model catalog
# and stats the weights under `bebop-vision/` in the repo checkout
# (`src/model.rs`); writes to `/home` are still denied.
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
