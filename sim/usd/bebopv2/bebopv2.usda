#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "bebopv2"
    doc = """Generated from Composed Stage of root layer /tmp/tmp1tl6hocs/bebopv2.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_bebopv2__rs9hxlp/usdex_bebopv2/bebopv2.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_bebopv2__rs9hxlp/temp_bebopv2/bebopv2.usd


Generated from Composed Stage of root layer /workspace/bebop_bot/sim/usd/bebopv2/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bebopv2" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    double3 xformOp:translate = (0, 0, 0.765)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    over "Geometry"
    {
        over "base_link"
        {
            def IsaacImuSensor "Imu_Sensor"
            {
                int angularVelocityFilterWidth = 1
                bool enabled = 1
                int linearAccelerationFilterWidth = 1
                int orientationFilterWidth = 1
                float sensorPeriod = 0.005
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            over "hip_flexion_left_1"
            {
                over "hip_abduction_left_1"
                {
                    over "knee_flexion_left_1"
                    {
                        over "foot_left_1" (
                            prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysxContactReportAPI"]
                        )
                        {
                            float physxContactReport:threshold = 0
                            float physxRigidBody:sleepThreshold = 0
                        }
                    }
                }
            }

            over "hip_flexion_right_1"
            {
                over "hip_abduction_right_1"
                {
                    over "knee_flexion_right_1"
                    {
                        over "foot_right_1" (
                            prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysxContactReportAPI"]
                        )
                        {
                            float physxContactReport:threshold = 0
                            float physxRigidBody:sleepThreshold = 0
                        }
                    }
                }
            }
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

