[Unit]
Description=Bebop model supervisor — GPU budget + Edge-LLM lifecycle on :9094
Documentation=https://github.com/ballerabdude/bebop
# Runs alongside the firmware and (root) starts/stops model backends — every
# generative model is a TensorRT Edge-LLM child process (omni, and a future
# VLA). Ordering keeps it from racing the runtime at boot.
After=network-online.target bebop-linux.service
Wants=network-online.target

[Service]
Type=simple
# Root is deliberate: it starts/stops model backends (child processes) and
# reads the root-only HF token.
User=root
Group=root
WorkingDirectory=/home/bebop/bebop/bebop-vision
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/bebop/bebop/bebop-vision
# The project's single venv (the same one bebop-voice runs from, so
# fastapi/uvicorn/httpx are present). Registry at
# config/models_supervisor.yaml (falls back to built-in defaults).
ExecStart=/home/bebop/bebop/bebop-vision/.venv/bin/python -u -m bebop_vision.models_supervisor
Restart=on-failure
RestartSec=5

[Install]
# Enabled by `install-jetson.sh --setup-models` (opt-in). It is a control
# plane, so keeping it up is cheap; model backends are still started on demand.
WantedBy=multi-user.target
