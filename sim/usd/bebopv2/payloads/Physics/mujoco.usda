Generated from Composed Stage of root layer /workspace/bebop_bot/sim/usd/corrected2/bebopv2/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "bebopv2"
{
    over "Physics"
    {
        def MjcActuator "knee_flexion_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </bebopv2/Physics/knee_flexion_left_joint>
        }

        def MjcActuator "knee_flexion_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </bebopv2/Physics/knee_flexion_right_joint>
        }

        def MjcActuator "foot_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </bebopv2/Physics/foot_left_joint>
        }

        def MjcActuator "foot_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </bebopv2/Physics/foot_right_joint>
        }

        def MjcActuator "hip_flexion_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </bebopv2/Physics/hip_flexion_right_joint>
        }

        def MjcActuator "hip_flexion_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </bebopv2/Physics/hip_flexion_left_joint>
        }

        def MjcActuator "hip_abduction_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </bebopv2/Physics/hip_abduction_right_joint>
        }

        def MjcActuator "hip_abduction_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </bebopv2/Physics/hip_abduction_left_joint>
        }

        over "hip_flexion_right_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "hip_flexion_left_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "root_joint"
        {
        }

        over "hip_abduction_right_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "hip_abduction_left_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "knee_flexion_right_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "knee_flexion_left_joint" (
