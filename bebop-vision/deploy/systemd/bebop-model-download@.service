[Unit]
Description=Bebop model weight download (%i)
Documentation=https://github.com/ballerabdude/bebop
# Fetching gated weights needs the network (the robot must be in Known
# Network / client mode with internet).
After=network-online.target
Wants=network-online.target

[Service]
# Long-running downloader: `Type=exec` lets systemd report `active` for the
# whole download (a `oneshot` would sit in `activating`, which the firmware
# historically only treated as idle). Exiting non-zero marks the unit failed;
# exiting zero returns it to inactive, at which point the presence of the
# weights file drives the `ready` state.
Type=exec
User=root
Group=root
WorkingDirectory=/home/bebop/bebop/bebop-vision
Environment=PYTHONUNBUFFERED=1
# Give the downloader a private /run/bebop for its status files.
RuntimeDirectory=bebop

# %i is the catalog model id (see config/models.yaml). The token is read
# from /etc/bebop/hf_token; progress is written to /run/bebop/models/%i.json
# and relayed to the app as `ModelState`.
#
# Deliberately NOT enabled: the operator starts it on demand from the app
# (firmware runs `systemctl start --no-block bebop-model-download@<id>`).
ExecStart=/home/bebop/bebop/bebop-vision/.venv/bin/python -u -m bebop_vision.download_model %i

[Install]
WantedBy=multi-user.target
