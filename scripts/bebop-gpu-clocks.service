[Unit]
Description=bebop: pin GPU devfreq governor to performance (GPU inference latency)
# Measured on the Orin, whose nvhost_podgov idled the GPU at ~306 MHz: the
# since-removed navd student model inferred only ~5 Hz (worker-paced), so
# every CUDA run paid the clock ramp: 107-118 ms unpinned vs 74 ms flat with
# this governor set (bench 2026-09-07). The same pinning applies to every
# GPU consumer on the robot (bebop-vision's perception, the Edge-LLM models).
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Devfreq node names vary across SoC generations: Orin exposes
# `17000000.gpu` (ends in `gpu`), while Thor exposes `gpu-gpc-0` /
# `gpu-nvd-0` (start with `gpu-`). Match `*gpu*` so both generations pin.
ExecStart=/bin/sh -c 'for g in /sys/class/devfreq/*gpu*; do [ -e "$g/governor" ] && echo performance > "$g/governor" || true; done'

[Install]
WantedBy=multi-user.target
