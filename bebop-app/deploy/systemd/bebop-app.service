[Unit]
Description=Bebop companion app (Vite dev server)
Documentation=https://github.com/your-org/bebop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bebop
Group=bebop
# The repo on the robot lives at /home/bebop/bebop.
WorkingDirectory=/home/bebop/bebop/bebop-app
ExecStart=/home/bebop/bebop/bebop-app/deploy/dev-server.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
