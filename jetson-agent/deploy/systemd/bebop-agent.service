[Unit]
Description=Bebop on-device provisioning agent (Wi-Fi setup + SoftAP)
Documentation=https://github.com/your-org/bebop
After=network-online.target NetworkManager.service
Wants=network-online.target NetworkManager.service

[Service]
Type=simple
# The setup agent runs as root because it needs NetworkManager write access
# to scan/join Wi-Fi and to raise the setup SoftAP (`nmcli`).
User=root
Group=root

Environment=RUST_LOG=info,bebop_agent=info
Environment=BEBOP_AGENT_CONFIG=/etc/bebop/agent.toml

ExecStart=/usr/local/bin/bebop-agent
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=15

# Hardening — relaxed because the agent needs NetworkManager D-Bus access.
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
